# Copy to .env and fill in your own values. .env is gitignored — NEVER commit keys.

# ─── Application ─────────────────────────────
APP_NAME=ApnaSOR
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ─── Exchange mode ───────────────────────────
# testnet = fake funds, real order books (development).
# mainnet = REAL money. Also requires ALLOW_MAINNET=true or the gateway refuses to start.
EXCHANGE_MODE=testnet
ALLOW_MAINNET=false

# Where ORDER BOOKS come from, independent of where orders execute.
# mainnet = real-market public feeds (no keys) -> cross-venue comparison is real.
MARKET_DATA_MODE=mainnet

# Comma-separated. Default = every venue where orders really execute:
#   binance (V1), bybit (V4), okx (V5), gate (V6).
# Optional: add "coinbase" (V2) as a DATA-ONLY reference venue (no real testnet).
# Not available: kraken (no spot testnet exists).
ENABLED_EXCHANGES=binance,bybit,okx,gate
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# MARKET orders go out as IOC limits capped this far past the planned price,
# so a book that moved (e.g. testnet vs mainnet) makes a child expire, not overpay.
CHILD_PRICE_PROTECTION_BPS=50
# A venue that refuses our API key's right to trade gets no new orders for this
# long, then one retry (its refused quantity is re-routed either way).
TRADING_BLOCK_COOLDOWN_S=600

# A venue+symbol whose testnet/demo book sits further than this from the real
# market is excluded from routing (Bybit's TESTNET was BTC ~+170 bps — which is
# why Bybit uses Demo Trading instead).
COHERENCE_THRESHOLD_BPS=50
COHERENCE_CHECK_INTERVAL_S=5

# ─── Binance ─────────────────────────────────
# Testnet keys: https://testnet.binance.vision/ -> log in with GitHub -> Generate HMAC_SHA256 Key.
# Without keys the system still streams real market data; trading is disabled.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Leave blank until the Phase 8 live demo. Only read when EXCHANGE_MODE=mainnet.
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# ─── Bybit (DEMO TRADING — not Testnet!) ─────
# bybit.com account -> switch to Demo Trading -> avatar -> API -> create key.
# Bybit's separate Testnet does NOT track the real market; Demo Trading does.
# Full steps: project-info/API_KEYS_GUIDE.md
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# ─── OKX (Demo Trading) ──────────────────────
# okx.com -> Trade -> Demo Trading -> Demo Trading API -> create key (read + trade).
# Demo keys are separate from live keys and need the passphrase you set.
OKX_TESTNET_API_KEY=
OKX_TESTNET_API_SECRET=
OKX_TESTNET_API_PASSPHRASE=

# ─── Gate (TestNet) ──────────────────────────
# Gate TestNet -> create API v4 key with spot trade permission.
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=

# Check every venue's keys at once:  python scripts/check_exchange_keys.py

# ─── Risk defaults (quantities in base asset, notionals in USDT) ──
DEFAULT_MAX_ORDER_SIZE=10000
DEFAULT_MAX_ORDER_NOTIONAL=10000
DEFAULT_MAX_POSITION=50000
DEFAULT_MAX_NOTIONAL=1000000
DEFAULT_MAX_ORDERS_PER_SECOND=50
# A whole TWAP (parent) order, so slicing can't dodge the per-order limit:
DEFAULT_MAX_ALGO_NOTIONAL=50000
# Portfolio controls (risk monitor). Trading loss below -this engages the kill switch; 0 = off.
DEFAULT_MAX_TRADING_LOSS=1000
DEFAULT_MAX_ASSET_CONCENTRATION_PCT=60
DEFAULT_MAX_VENUE_CONCENTRATION_PCT=80
RISK_MONITOR_INTERVAL_S=2.0
# Limits changed in the UI are saved in the audit store and win over these after a restart.

# ─── Risk batch (Phase 6): pre-flight + stress test on worker processes ──
# 0 = min(CPU cores, 4). Batches smaller than RISK_POOL_MIN_ORDERS stay in-process
# (process overhead would cost more than it saves — scripts/benchmark_risk_batch.py).
RISK_POOL_WORKERS=0
RISK_POOL_MIN_ORDERS=4
RISK_STRESS_PATHS=5000
RISK_STRESS_HORIZON_MIN=60
VOLATILITY_SAMPLE_INTERVAL_S=5.0

# ─── RAFT cluster (Phase 6) ───────────────────
# true = start_all.py starts 3 node processes that replicate the kill switch,
# risk limits and venue blacklist; the gateway writes through the leader.
# false = all of that stays local to the gateway (as before).
RAFT_ENABLED=false
# Always 127.0.0.1, not "localhost" (Windows tries IPv6 first: ~2 s per connection).
RAFT_CLUSTER_NODES=127.0.0.1:9001,127.0.0.1:9002,127.0.0.1:9003
# Empty = data/raft-<EXCHANGE_MODE>/ (one SQLite log per node, per machine)
RAFT_DATA_DIR=

# ─── Audit log / book of record (SQLite, created automatically) ──
# Empty = data/apnasor-<EXCHANGE_MODE>.db — testnet and mainnet never mix.
DATABASE_PATH=

# ─── Market data / health / wallet tuning ────
ORDERBOOK_SNAPSHOT_DEPTH=1000
MARKET_DATA_PUBLISH_INTERVAL_MS=250
FEED_STALENESS_THRESHOLD_MS=10000
ROUTING_DEPTH_LEVELS=50
VENUE_HEALTH_CHECK_INTERVAL_S=2.0
WALLET_REFRESH_INTERVAL_S=15.0

# ─── Auth ────────────────────────────────────
# Generate a real secret for any deployment beyond local.
JWT_SECRET=change-me-use-a-long-random-string-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ─── LLM copilot (Phase 5) ───────────────────
# Free key: https://aistudio.google.com/apikey (each person creates their own;
# don't enable billing). LLM_PROVIDER=off disables the copilot.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
COPILOT_PROPOSAL_TTL_S=120
COPILOT_MAX_PRICE_MOVE_BPS=100

# ─── Later phases (ignored by the gateway today) ──
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql+asyncpg://sor_user:sor_password@localhost:5432/apna_exchange

# ─── Frontend (read by Vite) ─────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
