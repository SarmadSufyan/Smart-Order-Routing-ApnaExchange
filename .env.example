# Copy to .env and fill in your own values. .env is gitignored — NEVER commit keys.

# ─── Application ─────────────────────────────
APP_NAME=ApnaSOR
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ─── Exchange mode ───────────────────────────
# testnet = fake funds, real order books (development).
# mainnet = REAL money. Also requires ALLOW_MAINNET=true or the gateway refuses to start.
EXCHANGE_MODE=testnet
ALLOW_MAINNET=false

# Where ORDER BOOKS come from, independent of where orders execute.
# mainnet = real-market public feeds (no keys) -> cross-venue comparison is real.
MARKET_DATA_MODE=mainnet

# Comma-separated. Default = every venue where orders really execute:
#   binance (V1), bybit (V4), okx (V5), gate (V6).
# Optional: add "coinbase" (V2) as a DATA-ONLY reference venue (no real testnet).
# Not available: kraken (no spot testnet exists).
ENABLED_EXCHANGES=binance,bybit,okx,gate
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# MARKET orders go out as IOC limits capped this far past the planned price,
# so a book that moved (e.g. testnet vs mainnet) makes a child expire, not overpay.
CHILD_PRICE_PROTECTION_BPS=50
# Liquidity-sweep routing caps every child this far past the best all-in price
# (price + taker fee). Wider = more certain fill, worse price.
SWEEP_BAND_BPS=20
# A venue that refuses our API key's right to trade gets no new orders for this
# long, then one retry (its refused quantity is re-routed either way).
TRADING_BLOCK_COOLDOWN_S=600

# A venue+symbol whose testnet/demo book sits further than this from the real
# market is excluded from routing (Bybit's TESTNET was BTC ~+170 bps — which is
# why Bybit uses Demo Trading instead).
COHERENCE_THRESHOLD_BPS=50
COHERENCE_CHECK_INTERVAL_S=5

# ─── Binance ─────────────────────────────────
# Testnet keys: https://testnet.binance.vision/ -> log in with GitHub -> Generate HMAC_SHA256 Key.
# Without keys the system still streams real market data; trading is disabled.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Real-money keys for every exchange: section "Real money" at the end.

# ─── Bybit (DEMO TRADING — not Testnet!) ─────
# bybit.com account -> switch to Demo Trading -> avatar -> API -> create key.
# Bybit's separate Testnet does NOT track the real market; Demo Trading does.
# Full steps: project-info/API_KEYS_GUIDE.md
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# ─── OKX (Demo Trading) ──────────────────────
# okx.com -> Trade -> Demo Trading -> Demo Trading API -> create key (read + trade).
# Demo keys are separate from live keys and need the passphrase you set.
OKX_TESTNET_API_KEY=
OKX_TESTNET_API_SECRET=
OKX_TESTNET_API_PASSPHRASE=

# ─── Gate (TestNet) ──────────────────────────
# Gate TestNet -> create API v4 key with spot trade permission.
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=

# Check every venue's keys at once:  python scripts/check_exchange_keys.py

# ─── Risk defaults (quantities in base asset, notionals in USDT) ──
DEFAULT_MAX_ORDER_SIZE=10000
DEFAULT_MAX_ORDER_NOTIONAL=10000
DEFAULT_MAX_POSITION=50000
DEFAULT_MAX_NOTIONAL=1000000
DEFAULT_MAX_ORDERS_PER_SECOND=50
# A whole TWAP (parent) order, so slicing can't dodge the per-order limit:
DEFAULT_MAX_ALGO_NOTIONAL=50000
# Portfolio controls (risk monitor). Trading loss below -this engages the kill switch; 0 = off.
DEFAULT_MAX_TRADING_LOSS=1000
DEFAULT_MAX_ASSET_CONCENTRATION_PCT=60
DEFAULT_MAX_VENUE_CONCENTRATION_PCT=80
RISK_MONITOR_INTERVAL_S=2.0
# Limits changed in the UI are saved in the audit store and win over these after a restart.

# ─── Risk batch (Phase 6): pre-flight + stress test on worker processes ──
# 0 = min(CPU cores, 4). Batches smaller than RISK_POOL_MIN_ORDERS stay in-process
# (process overhead would cost more than it saves — scripts/benchmark_risk_batch.py).
RISK_POOL_WORKERS=0
RISK_POOL_MIN_ORDERS=4
RISK_STRESS_PATHS=5000
RISK_STRESS_HORIZON_MIN=60
VOLATILITY_SAMPLE_INTERVAL_S=5.0

# ─── RAFT cluster (Phase 6) ───────────────────
# true = start_all.py starts 3 node processes that replicate the kill switch,
# risk limits and venue blacklist; the gateway writes through the leader.
# false = all of that stays local to the gateway (as before).
RAFT_ENABLED=false
# Always 127.0.0.1, not "localhost" (Windows tries IPv6 first: ~2 s per connection).
RAFT_CLUSTER_NODES=127.0.0.1:9001,127.0.0.1:9002,127.0.0.1:9003
# Required when RAFT_ENABLED=true: every RAFT message is signed with it (HMAC-SHA256),
# so no other program can talk to the nodes. Make your own (never share it):
#   python -c "import secrets; print(secrets.token_hex(32))"
RAFT_SHARED_SECRET=
# Empty = data/raft-<EXCHANGE_MODE>/ (one SQLite log per node, per machine)
RAFT_DATA_DIR=

# ─── Arbitrage detector (5c): detection only, never trades ──
ARB_ENABLED=true
ARB_SCAN_INTERVAL_MS=250
# Base-tier spot TAKER fee per exchange, in bps (10 = 0.10%). Both legs would be
# IOC orders = taker. Defaults: each exchange's public base tier (ccxt, 2026-10-04).
# Since 2026-10-07 the ROUTER ranks venues by price + this fee too.
ARB_TAKER_FEES_BPS=binance:10,bybit:10,okx:15,gate:20,coinbase:120
# "Profitable" = net edge after both fees above this (bps)
ARB_MIN_NET_BPS=0
# At most one audit entry per direction (coin + buy venue + sell venue) per this
ARB_AUDIT_COOLDOWN_S=60

# ─── Audit log / book of record (SQLite, created automatically) ──
# Empty = data/apnasor-<EXCHANGE_MODE>.db — testnet and mainnet never mix.
DATABASE_PATH=

# ─── Market data / health / wallet tuning ────
ORDERBOOK_SNAPSHOT_DEPTH=1000
MARKET_DATA_PUBLISH_INTERVAL_MS=250
FEED_STALENESS_THRESHOLD_MS=10000
ROUTING_DEPTH_LEVELS=50
VENUE_HEALTH_CHECK_INTERVAL_S=2.0
WALLET_REFRESH_INTERVAL_S=15.0

# ─── Auth ────────────────────────────────────
# Signs every login token (whoever knows it can forge any login). Leave EMPTY:
# the gateway creates a random one for this machine the first time it starts
# (data/jwt-secret-<EXCHANGE_MODE>.key, never in git). Set your own only if you
# need to - 32+ characters:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Real login passwords - stored only as scrypt hashes, never the password.
# Empty = that user keeps the demo login (password = user name), testnet only;
# with EXCHANGE_MODE=mainnet a user without a real password can't log in.
# Make the line (asks for the password, prints the line to paste here):
#   python scripts/hash_password.py admin
# The demo laptop must have all three. Guide: project-info/SECURITY_GUIDE.md
AUTH_PASSWORD_HASH_ADMIN=
AUTH_PASSWORD_HASH_TRADER1=
AUTH_PASSWORD_HASH_RISK_MGR=

# ─── Browser access (CORS) ───────────────────
# Which web pages may use the API (and the live /ws connection) from a browser.
# Empty = the frontend on this machine (localhost / 127.0.0.1, any port).
# Otherwise a comma-separated list of exact addresses - then ONLY those, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
# "*" (any website) is refused: any page you open could then log in and trade.
CORS_ORIGINS=

# ─── LLM copilot ──────────────────────────────
# The copilot reads a message, answers from the system's own numbers, and proposes actions you confirm
# (project-info/COPILOT_GUIDE.md). Pick the model: gemini (free, the default), claude (paid per use,
# stronger), or off. The quick analysis on the Copilot panel works with no key at all.
LLM_PROVIDER=gemini
# Gemini: free key at https://aistudio.google.com/apikey (each person their own; don't enable billing).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Claude: your own key from https://console.anthropic.com (billed per use). Own names on purpose:
# ANTHROPIC_API_KEY / CLAUDE_* may already be set on a developer machine by other tools.
COPILOT_CLAUDE_API_KEY=
COPILOT_CLAUDE_MODEL=claude-opus-5-5
COPILOT_CLAUDE_EFFORT=low
COPILOT_PROPOSAL_TTL_S=120
COPILOT_MAX_PRICE_MOVE_BPS=100
# Auto (sandbox only): a proposed order/algorithm up to this size, with no warnings, runs without a click.
COPILOT_AUTO_MAX_USDT=50
# The most a copilot trade suggestion is sized to (real money: the MAINNET_MAX_* caps also apply).
COPILOT_MAX_SUGGEST_USDT=100

# ─── Later phases (ignored by the gateway today) ──
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql+asyncpg://sor_user:sor_password@localhost:5432/apna_exchange

# ─── Frontend (read by Vite) ─────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ─── Lab server (deploy/lab-server; testnet only) ──
# After a restart, resume the LAB bots that were running when the gateway stopped, this many seconds
# after the start. Off (the default, and right for a laptop): every bot comes back paused for a person
# to review. The lab server turns it on (project-info/LAB_SERVER_GUIDE.md).
LAB_AUTO_RESUME=false
LAB_AUTO_RESUME_DELAY_S=60

# ─── Research (Phase B) ──────────────────────
# Candle history + the live forecast log. Empty = data/market-history.db (real-market data).
MARKET_HISTORY_DB_PATH=

# ─── Real money (Phase D) ────────────────────
# Read ONLY when EXCHANGE_MODE=mainnet (+ ALLOW_MAINNET=true). Step by step: project-info/REAL_MONEY_GUIDE.md.
# Each key: read + SPOT TRADE only, WITHDRAWALS OFF. The gateway asks the exchange what the key may do and
# gives a key that can withdraw no orders. Your own keys only: never shared, never copied to the lab server.
# Check them first (read-only, nothing switches):  python scripts/check_exchange_keys.py --mode mainnet
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
BYBIT_MAINNET_API_KEY=
BYBIT_MAINNET_API_SECRET=
OKX_MAINNET_API_KEY=
OKX_MAINNET_API_SECRET=
OKX_MAINNET_API_PASSPHRASE=
GATE_MAINNET_API_KEY=
GATE_MAINNET_API_SECRET=
# Hard caps in USDT. No risk limit in force is ever above them; the Risk page can only tighten them.
# Raising one = edit here and restart. Every one must be above 0 (the loss limit can't be off).
MAINNET_MAX_ORDER_USDT=25
MAINNET_MAX_ALGO_USDT=100
MAINNET_MAX_EXPOSURE_USDT=150
MAINNET_MAX_TRADING_LOSS_USDT=10
# Profit-cycle bots trade without asking: off on real money until you have read the practice lab's verdict.
MAINNET_CYCLE_BOTS=false
# Each real key must be locked to the real-money server's fixed IP on the exchange; a key without an IP list gets
# no orders (the exchange is asked). project-info/PHASE_D_PLAN.md, wall 3.
MAINNET_REQUIRE_IP_LOCK=true

# ─── Phone alerts (Telegram) ─────────────────────────────────────────
# A bot made with @BotFather and the one chat it reports to: kill switch, loss limit, gateway start/stop, real fills,
# a daily summary; /stop from that chat engages the kill switch (releasing needs the screen). Empty = no alerts.
# On the real-money server: `python deploy/real-server/deploy.py telegram` puts them in its root-only keys.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hour (UTC) of the daily summary: 3 = 08:00 in Pakistan
ALERTS_SUMMARY_HOUR_UTC=3
